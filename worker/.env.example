# AI + search
ANTHROPIC_API_KEY=sk-ant-...
SERPER_API_KEY=...                # serper.dev

# Git target (the repo Vercel deploys)
REPO_URL=https://github.com/you/your-news-site.git
REPO_BRANCH=main
GIT_TOKEN=ghp_...                 # GitHub PAT, "repo" scope (fine-grained: Contents read/write)
GIT_AUTHOR_NAME=news-bot
GIT_AUTHOR_EMAIL=bot@example.com

# Where content + images go in the repo
CONTENT_DIR=content/articles
IMAGE_DIR=public/covers

# Cover images (optional; stock first, AI fallback)
PEXELS_API_KEY=...
IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_API_KEY=...
IMAGE_MODEL=gpt-image-1

# Behaviour
COUNTRIES=US,GB
MAX_ARTICLES_PER_RUN=5
